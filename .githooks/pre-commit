#!/usr/bin/env bash
set -e

if [ -f package.json ] && command -v npm &>/dev/null; then
    echo "pre-commit: oxlint + oxfmt check"
    if ! npm run lint 2>&1; then
        echo "ERROR: lint/format checks failed. Run 'make fmt' for formatting or fix lint errors before committing."
        exit 1
    fi

    echo "pre-commit: tsc --noEmit"
    if ! npm run typecheck 2>&1; then
        echo "ERROR: typecheck failed. Fix type errors before committing."
        exit 1
    fi
fi
